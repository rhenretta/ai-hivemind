# Environment Variables
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets.
# See docs/WORKFLOW.md §6 for the full environment management rules.

# ─── Nerve Center (apps/backend) ──────────────────────────────────────────────

# Port the HTTP + WebSocket server listens on (default: 3001)
PORT=3001

# CORS allowed origin for the Command Center frontend
# In development, allow all origins. In production, set to the exact Command Center URL.
BACKEND_CORS_ORIGIN=*

# ─── OpenAI LLM Service ───────────────────────────────────────────────────────

# Required for Coordinator and any tier:high/tier:low agents.
# Without this, the Coordinator logs a warning and skips LLM calls gracefully.
OPENAI_API_KEY=sk-...

# Model to use for coordinator / planner (tier: 'high')
OPENAI_HIGH_TIER_MODEL=gpt-4o

# Model to use for simple tool-executor agents (tier: 'low')
OPENAI_LOW_TIER_MODEL=gpt-4o-mini

# ─── Reddit API ──────────────────────────────────────────────────────────────

# Reddit API Client ID (from https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id

# Reddit API Client Secret
REDDIT_CLIENT_SECRET=your_client_secret

# Reddit User Agent (e.g., "script:my-app:v1.0.0 (by /u/your_username)")
REDDIT_USER_AGENT=script:ai-hivemind:v0.1.0 (by /u/your_username)

# ─── Claude Code CLI ──────────────────────────────────────────────────────────

# Required for Docker sandbox. Claude Code inside the container needs an API key
# since macOS Keychain OAuth tokens are not accessible from Docker.
ANTHROPIC_API_KEY=sk-ant-...

# Path or name of the Claude Code CLI binary (default: claude).
CLAUDE_CLI_BIN=claude

# Maximum number of agentic turns per task (default: 50).
# CLAUDE_MAX_TURNS=50

# ─── General ──────────────────────────────────────────────────────────────────

# Node environment: development | test | production
NODE_ENV=development

# Structured log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
