{
    "name": "@ai-hivemind/ui",
    "version": "0.1.0",
    "description": "Shared UI component library — design system primitives for the Command Center",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "lint": "eslint src --max-warnings=0",
        "lint:fix": "eslint src --fix",
        "type-check": "tsc --noEmit",
        "test:unit": "vitest run --coverage",
        "clean": "rm -rf dist .turbo"
    },
    "dependencies": {
        "@ai-hivemind/shared": "workspace:*",
        "react": "^19.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.0.0",
        "@vitejs/plugin-react": "^4.3.0",
        "vite": "^5.2.0",
        "vitest": "^1.5.0",
        "@vitest/coverage-v8": "^1.5.0"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "publishConfig": {
        "access": "restricted"
    }
}