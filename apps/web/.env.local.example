# Command Center — Environment Variables
# Copy to .env.local for local development. Never commit .env.local.

# URL of the Nerve Center backend (Express + Socket.io)
# Phase 1 defaults to port 3001
NEXT_PUBLIC_NERVE_CENTER_URL=http://localhost:3001

# Maximum events to retain in the in-memory ledger store (prevents memory leak)
NEXT_PUBLIC_MAX_LEDGER_EVENTS=2000
