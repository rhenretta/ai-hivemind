{
    "name": "@ai-hivemind/backend",
    "version": "0.1.0",
    "private": true,
    "description": "Nerve Center — WebSocket event bus, agent lifecycle manager, MCP registry, and global execution ledger",
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file=../../.env.local src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "lint": "eslint src --max-warnings=0",
        "lint:fix": "eslint src --fix",
        "type-check": "tsc --noEmit",
        "test:unit": "vitest run --coverage",
        "clean": "rm -rf dist .turbo"
    },
    "dependencies": {
        "@ai-hivemind/shared": "workspace:*",
        "better-sqlite3": "^12.6.2",
        "cors": "^2.8.5",
        "dotenv": "^17.3.1",
        "express": "^4.19.0",
        "node-pty": "^1.1.0",
        "openai": "^6.25.0",
        "socket.io": "^4.7.0",
        "uuid": "^10.0.0",
        "zod": "^3.23.0"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.0.0",
        "@types/supertest": "^7.2.0",
        "@types/uuid": "^10.0.0",
        "@vitest/coverage-v8": "^1.5.0",
        "concurrently": "^8.2.0",
        "supertest": "^7.2.2",
        "tsx": "^4.11.0",
        "vitest": "^1.5.0"
    }
}